# Copy this file to .env and adjust:  cp .env.example .env

# Base URL of the Express backend API.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---- Deployment (e.g. Vercel) ----
# Backend origin, no /api suffix. When set, /api/* is proxied to it (see
# next.config.mjs) so the refresh cookie stays first-party, and server-side
# fetches call it directly. Pair it with NEXT_PUBLIC_API_URL=/api.
# Leave unset for local dev.
#BACKEND_URL=https://your-backend.onrender.com

# Legacy ElevenLabs voice-agent id. Not used by the multi-tenant portfolio
# render (a single global agent doesn't fit multi-tenant). Left here only for
# reference — safe to omit.
#NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
